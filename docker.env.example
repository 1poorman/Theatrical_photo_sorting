# 可选：复制为 .env.docker，修改后启动：
# docker compose --env-file .env.docker up -d --build
# 此文件只用于 Compose 参数；现有 .env 的大模型配置另行只读挂载。

# 宿主机物理 GPU 编号；容器内映射为 GPU0。
DOCKER_GPU_DEVICE=0
DOCKER_FACE_DEVICE=tensorrt
DOCKER_IMAGE_VECTOR_BACKEND=qdrant
DOCKER_FACE_VECTOR_BACKEND=qdrant
DOCKER_QDRANT_IMAGE=qdrant/qdrant:v1.20.0
DOCKER_QDRANT_MEMORY=4g
DOCKER_UI_PORT=8199
DOCKER_WEIGHTS_DIR=./weights
DOCKER_ELASTIC_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.12.2
# 网络较慢时可改用 https://pypi.tuna.tsinghua.edu.cn/simple 等镜像。
DOCKER_PIP_INDEX_URL=https://pypi.org/simple

# 首次初始化 Elasticsearch 时设置密码；后续改密码需在 ES 内执行密码更新。
DOCKER_ELASTIC_PASSWORD=theatrical-local-password
